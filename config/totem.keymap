#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define DEAD 3
#define GAME 4
#define SYS  5

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    behaviors {
        star_lt: star_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        /*
         * DEAD layer glyphs are firmware-side Windows Alt-code macros.
         * They keep the host layout on English (United States) without
         * requiring an Ergo-L or US-International OS layout.
         */
        dead_a_circ: dead_a_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };

        dead_c_cedilla: dead_c_cedilla {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N1>
                , <&macro_release &kp LALT>
                ;
        };

        dead_oe: dead_oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };

        dead_o_circ: dead_o_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N4>
                , <&macro_release &kp LALT>
                ;
        };

        dead_a_grave: dead_a_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N4>
                , <&macro_release &kp LALT>
                ;
        };

        dead_e_acute: dead_e_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N3>
                , <&macro_release &kp LALT>
                ;
        };

        dead_e_grave: dead_e_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N2>
                , <&macro_release &kp LALT>
                ;
        };

        dead_e_circ: dead_e_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N4>
                , <&macro_release &kp LALT>
                ;
        };

        dead_n_tilde: dead_n_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N1>
                , <&macro_release &kp LALT>
                ;
        };

        dead_ae: dead_ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N0>
                , <&macro_release &kp LALT>
                ;
        };

        dead_ss: dead_ss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N3>
                , <&macro_release &kp LALT>
                ;
        };

        dead_micro: dead_micro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N1>
                , <&macro_release &kp LALT>
                ;
        };

        dead_u_circ: dead_u_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N5 &kp KP_N1>
                , <&macro_release &kp LALT>
                ;
        };

        dead_i_circ: dead_i_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N8>
                , <&macro_release &kp LALT>
                ;
        };

        dead_i_dia: dead_i_dia {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N9>
                , <&macro_release &kp LALT>
                ;
        };

        dead_u_grave: dead_u_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N9>
                , <&macro_release &kp LALT>
                ;
        };

        dead_ellipsis: dead_ellipsis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N3 &kp KP_N3>
                , <&macro_release &kp LALT>
                ;
        };

        dead_alpha: dead_alpha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N2 &kp KP_N2 &kp KP_N4>
                , <&macro_release &kp LALT>
                ;
        };

        dead_middle_dot: dead_middle_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N3>
                , <&macro_release &kp LALT>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_game_toggle {
            timeout-ms = <140>;
            key-positions = <20 31>;
            bindings = <&tog GAME>;
            layers = <BASE GAME>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
                &kp Q           &kp C           &kp O           &kp P           &kp W           &kp J           &kp M           &kp D           &star_lt DEAD EXCL &kp Y
                &mt LGUI A      &mt LALT S      &mt LSHFT E     &mt LCTRL N     &kp F           &kp L           &mt RCTRL R     &mt RSHFT T     &mt RALT I      &mt RGUI U
                &kp TAB         &kp Z           &kp X           &kp QMARK       &kp V           &kp B           &kp COLON       &kp H           &kp G           &kp SEMI        &kp K           &lt SYS DEL
                                                &kp LSHFT       &mo NAV         &kp SPACE       &kp RET         &mo SYM         &kp BSPC
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
                &kp TAB         &kp HOME        &kp UP          &kp END         &kp PG_UP       &kp FSLH        &kp N7          &kp N8          &kp N9          &trans
                &kp LSHFT       &kp LEFT        &kp DOWN        &kp RIGHT       &kp PG_DN       &kp MINUS       &kp N4          &kp N5          &kp N6          &kp N0
                &trans          &trans          &kp C_VOL_DN    &kp C_MUTE      &kp C_VOL_UP    &kp BSPC        &kp COMMA       &kp N1          &kp N2          &kp N3          &kp DOT         &trans
                                                &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
                &kp CARET       &kp LT          &kp GT          &kp DLLR        &kp PRCNT       &kp AT          &kp AMPS        &kp STAR        &kp SQT         &kp GRAVE
                &kp LBRC        &kp LPAR        &kp RPAR        &kp RBRC        &kp EQUAL       &kp BSLH        &kp PLUS        &kp MINUS       &kp FSLH        &kp DQT
                &trans          &kp TILDE       &kp LBKT        &kp RBKT        &kp UNDER       &kp HASH        &kp PIPE        &kp EXCL        &kp SEMI        &kp COLON       &kp QMARK       &trans
                                                &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        dead_layer {
            label = "DEAD";
            bindings = <
                &dead_a_circ    &dead_c_cedilla &dead_oe        &dead_o_circ    &trans          &trans          &dead_micro     &trans          &trans          &dead_u_circ
                &dead_a_grave   &dead_e_acute   &dead_e_grave   &dead_e_circ    &dead_n_tilde   &kp LPAR        &kp RPAR        &dead_i_circ    &dead_i_dia     &dead_u_grave
                &trans          &dead_ae        &dead_ss        &trans          &trans          &trans          &dead_ellipsis  &trans          &dead_alpha     &dead_middle_dot &trans         &trans
                                                &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        game_layer {
            label = "GAME";
            bindings = <
                &kp ESC         &kp Q           &kp W           &kp E           &kp R           &kp Y           &kp U           &kp I           &kp O           &kp P
                &kp TAB         &kp A           &kp S           &kp D           &kp F           &kp H           &kp J           &kp K           &kp L           &kp SEMI
                &mo SYS         &kp LSHFT       &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH
                                                &kp LSHFT       &kp SPACE       &kp LCTRL       &kp SPACE       &kp SPACE       &kp RET
            >;
        };

        sys_layer {
            label = "SYS";
            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_CLR      &out OUT_TOG    &kp KP_NUMLOCK  &trans          &trans          &trans
                &bootloader     &sys_reset      &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                                                &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };
    };
};
